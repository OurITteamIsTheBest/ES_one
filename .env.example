# Copy to .env and fill real values.  ⚠ DO NOT COMMIT .env

# Environment: "development" (default) or "production".
# In production the app REFUSES to start without a proper JWT_SECRET and COOKIE_SECURE=true.
ENV=development

# ==== Database ====
# PostgreSQL connection URL (Neon recommended — free tier).
# For Vercel deployments use the POOLED connection string:
#   postgres://user:pw@ep-xyz-pooler.eu-central-1.aws.neon.tech/es_one?sslmode=require
# For local dev / initial migration use the DIRECT (non-pooled) URL.
DATABASE_URL=postgres://user:pw@host:5432/es_one?sslmode=require

# ==== Auth ====
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# First super admin (created only if DB has no super_admin yet)
BOOTSTRAP_EMAIL=zhunussov_zh@eng-services.kz
BOOTSTRAP_NAME=Жунусов Жанат
BOOTSTRAP_PASSWORD=ChooseAStrongPasswordHere

# ==== Cookies & CORS ====
# In production always true (HTTPS-only cookies).
COOKIE_SECURE=false
# Optional: COOKIE_DOMAIN=your.domain

# Comma-separated allowed origins for the frontend.
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==== Login security ====
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_SECONDS=900
